<%- include("_header", { title: "Orders", appName, logoUrl, user }) %>

<%
  const safeNum = (v) => Number(v || 0) || 0;

  const fmtDate = (iso) => {
    try {
      if (!iso) return "";
      return new Date(iso).toLocaleString();
    } catch (e) {
      return "";
    }
  };

  const statusBadge = (st) => {
    const s = String(st || "").toLowerCase();
    if (s === "pending") return "secondary";
    if (s === "assigned") return "primary";
    if (s === "accepted") return "info";
    if (s === "onway") return "warning";
    if (s === "delivered") return "success";
    if (s === "cancelled") return "dark";
    return "light";
  };

  const qtyForBill = (o) => {
    const dq = safeNum(o && o.delivered_qty);
    if (dq > 0) return dq;
    return safeNum(o && o.quantity_requested);
  };

  const totalBill = (o) => safeNum(o && o.unit_price) * qtyForBill(o);

  const paidAmt = (o) => safeNum(o && o.payment_amount);

  const dueAmt = (o) => Math.max(0, totalBill(o) - paidAmt(o));

  const outstandingAmt = (o) => Math.max(0, safeNum(o && o.outstanding));

  const totalDueAfterDelivery = (o) => {
    const st = String(o && o.status ? o.status : "").toLowerCase();
    if (st === "delivered") return outstandingAmt(o);
    return outstandingAmt(o) + dueAmt(o);
  };

  const isJazzPending = (o) => {
    const m = String((o && o.payment_method) || "").toLowerCase();
    const pr = safeNum(o && o.payment_received);
    return (String(o.status || "").toLowerCase() === "delivered") && (m === "jazzcash") && (pr === 0);
  };

  const allOrders = Array.isArray(orders) ? orders : [];
  const getSt = (o) => String((o && o.status) || "").toLowerCase();

  const pendingOrders = allOrders.filter(o => getSt(o) === "pending");

  const inProgressOrders = allOrders.filter(o => {
    const st = getSt(o);
    if (st === "pending") return false;
    if (st === "delivered") return false;
    return true;
  });

  const deliveredOrders = allOrders.filter(o => getSt(o) === "delivered");
%>

<style>
  .badge_admin{
    display:inline-block;
    padding:2px 8px;
    border-radius:999px;
    font-size:12px;
    font-weight:800;
    background:#fff7ed;
    border:1px solid #fed7aa;
    color:#9a3412;
    margin-left:8px;
    vertical-align:middle;
  }

  .btn_primary{
    background:#111827;color:#fff;border:0;border-radius:10px;
    padding:10px 14px;cursor:pointer;font-weight:600
  }
  .btn_ghost{
    background:#fff;color:#111827;border:1px solid #e5e7eb;border-radius:10px;
    padding:10px 14px;cursor:pointer;font-weight:600
  }
  .modal_backdrop{
    position:fixed;inset:0;background:rgba(0,0,0,.45);
    display:flex;align-items:center;justify-content:center;z-index:9999;
    padding:16px
  }
  .hidden{display:none !important}
  .modal_card{
    width:100%;max-width:720px;background:#fff;border-radius:14px;
    box-shadow:0 20px 50px rgba(0,0,0,.2);overflow:hidden
  }
  .modal_head{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 16px;border-bottom:1px solid #eee
  }
  .modal_body{padding:16px}
  .form_row{margin:10px 0}
  .form_row label{display:block;font-weight:700;margin-bottom:6px}
  .form_row input,.form_row select{
    width:100%;padding:10px 12px;border:1px solid #e5e7eb;border-radius:10px;
    outline:none
  }
  .result_list{
    border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;margin-top:10px
  }
  .result_item{
    padding:10px 12px;border-bottom:1px solid #f1f5f9;cursor:pointer
  }
  .result_item:hover{background:#f9fafb}
  .result_item:last-child{border-bottom:0}
  .muted{color:#6b7280;font-size:12px}
  .selected_box{
    margin-top:12px;padding:12px;border:1px solid #dbeafe;background:#eff6ff;border-radius:12px
  }
  .modal_actions{display:flex;gap:10px;justify-content:flex-end;margin-top:14px}
  .msg{margin-top:10px;font-size:13px}
  .msg_ok{color:#065f46}
  .msg_err{color:#b91c1c}
</style>

<div class="card cardsoft p-3 p-md-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <div class="h5 mb-1">Orders</div>
      <div class="smallmuted">Assign riders and manage status and payments</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" id="btnGenOrder" class="btn btn-primary btnround">Generate Order</button>
      <a class="btn btn-outline-dark btnround" href="/admin">Dashboard</a>
      <a class="btn btn-outline-primary btnround" href="/admin/pending_jazzcash">Pending JazzCash</a>
    </div>
  </div>

  <hr class="my-3">

  <% if (!allOrders || allOrders.length === 0) { %>
    <div class="text-muted text-center py-4">No orders</div>
  <% } %>

  <!-- Mobile cards -->
  <div class="d-block d-md-none">

    <% if (pendingOrders.length > 0) { %>
      <div class="small text-muted mb-2">Pending orders</div>
    <% } %>

    <% (pendingOrders || []).forEach(o => { 
        const qty = qtyForBill(o);
        const total = totalBill(o);
        const paid = paidAmt(o);
        const due = dueAmt(o);
        const out = outstandingAmt(o);
        const totalAll = totalDueAfterDelivery(o);
        const st = String(o.status || "");
        const badge = statusBadge(st);
        const riderNow = o.rider_name || "";
        const waterNow = o.water_name || "";
        const methodNow = String(o.payment_method || "").toLowerCase();
        const jazzPending = isJazzPending(o);
        const isDelivered = String(o.status || "").toLowerCase() === "delivered";
        const byAdmin = String(o.created_source || "").toLowerCase() === "admin";
