      <div class="card mb-2 <%= jazzPending ? 'border-warning' : '' %>">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
              <div class="fw-bold">Order #<%= o.id %></div>
              <div class="text-muted small">
                <%= o.customer_name || "" %>
                <% if (byAdmin) { %><span class="badge_admin">by admin</span><% } %>
              </div>
              <div class="text-muted small">
                Water <%= waterNow || "NA" %>  Qty <%= qty %>
              </div>
            </div>
            <div class="text-end">
              <span class="badge bg-<%= badge %>"><%= st %></span>
              <% if (jazzPending) { %>
                <div class="small text-warning mt-1">JazzCash pending</div>
              <% } %>
            </div>
          </div>

          <div class="mt-2 small">
            <div>Order total <strong><%= total %> <%= currency %></strong></div>
            <div>
              Order paid <strong><%= paid %> <%= currency %></strong>
              Order due <strong class="<%= due > 0 ? 'text-danger' : '' %>"><%= due %> <%= currency %></strong>
            </div>

            <% if (!isDelivered) { %>
              <div>
                Previous udhaar
                <strong class="<%= out > 0 ? 'text-danger' : 'text-muted' %>"><%= out %> <%= currency %></strong>
              </div>
              <div>
                Total due after delivery
                <strong class="<%= totalAll > 0 ? 'text-danger' : 'text-muted' %>"><%= totalAll %> <%= currency %></strong>
              </div>
            <% } else { %>
              <div>
                Customer outstanding
                <strong class="<%= out > 0 ? 'text-danger' : 'text-muted' %>"><%= out %> <%= currency %></strong>
              </div>
            <% } %>

            <div class="text-muted">Created <%= fmtDate(o.created_at) %></div>
            <% if (o.delivered_at) { %><div class="text-muted">Delivered <%= fmtDate(o.delivered_at) %></div><% } %>
            <% if (riderNow) { %><div class="text-muted">Rider <%= riderNow %></div><% } %>
          </div>

