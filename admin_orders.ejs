                    <option value="onway" <%= o.status==="onway"?"selected":"" %>>On the way</option>
                    <option value="cancelled" <%= o.status==="cancelled"?"selected":"" %>>Cancelled</option>
                  </select>
                  <button class="btn btn-sm btn-outline-primary btnround">Update</button>
                </form>

                <form method="post" action="/admin/orders/<%= o.id %>/assign" class="d-flex gap-2 align-items-center mb-2">
                  <select class="form-select form-select-sm" name="rider_id" required>
                    <option value="">Select rider</option>
                    <% (riders || []).forEach(r => { %>
                      <option value="<%= r.id %>" <%= String(o.rider_id||"")===String(r.id) ? "selected" : "" %>><%= r.name %> (<%= r.id %>)</option>
                    <% }) %>
                  </select>
