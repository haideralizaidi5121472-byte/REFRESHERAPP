<%- include("_header", { title: "Admin Login", appName, logoUrl, user }) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-6">
    <div class="card cardsoft p-4">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <div class="h4 mb-1">Admin login</div>
          <div class="smallmuted">Use admin username and password</div>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-dark btnround" href="/login/customer">Customer</a>
          <a class="btn btn-outline-dark btnround" href="/login/rider">Rider</a>
        </div>
      </div>

      <% if (msg) { %>
        <div class="alert alert-warning"><%= msg %></div>
      <% } %>

      <form method="post" action="/login/admin" class="row g-3" autocomplete="off">
        <div class="col-12">
          <label class="form-label">Username</label>
          <input name="username" class="form-control" placeholder="admin" autocomplete="off" required>
        </div>
        <div class="col-12">
          <label class="form-label">Password</label>
          <input name="password" type="password" class="form-control" placeholder="Admin password" autocomplete="current-password" required>
        </div>
        <div class="col-12">
          <button class="btn btn-primary btnround px-4">Open admin dashboard</button>
        </div>
      </form>

      <hr class="my-4">
      <div class="smallmuted">
        First run default admin
        <div>Username admin</div>
        <div>Password refresher123</div>
      </div>
    </div>
  </div>
</div>

<%- include("_footer") %>
