<%- include("_header", { title: "Customer Login", appName, logoUrl, user }) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-6">
    <div class="card cardsoft p-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
          <div class="h4 mb-1">Customer login</div>
          <div class="smallmuted">Enter your customer ID and PIN</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-dark btnround" href="/login/rider">Rider</a>
          <a class="btn btn-outline-dark btnround" href="/login/admin">Admin</a>
        </div>
      </div>

      <% if (msg) { %>
        <div class="alert alert-warning"><%= msg %></div>
      <% } %>

      <form id="customerLoginForm" method="post" action="/login/customer" class="row g-3" autocomplete="on">
        <div class="col-12">
          <label class="form-label" for="customerId">Customer ID</label>
          <input
            id="customerId"
            name="id"
            class="form-control"
            placeholder="Example 35 or C0001"
            autocomplete="username"
            inputmode="text"
            autocapitalize="none"
            spellcheck="false"
            required
          >
        </div>

        <div class="col-12">
          <label class="form-label" for="customerPin">PIN</label>
          <div class="input-group">
            <input
              id="customerPin"
              name="pin"
              type="password"
              class="form-control"
              placeholder="Example 12345"
              inputmode="numeric"
              autocomplete="current-password"
              required
            >
            <button class="btn btn-outline-secondary" type="button" id="togglePin">Show</button>
          </div>
          <div class="form-text">If you do not know your PIN ask admin</div>
        </div>

        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" value="1" id="remember" name="remember" checked>
            <label class="form-check-label" for="remember">Remember this device</label>
          </div>
          <div class="form-text">Customer ID will be remembered on this device if this is enabled</div>
        </div>

        <div class="col-12 d-grid">
          <button class="btn btn-primary btnround px-4">Open dashboard</button>
        </div>
      </form>

      <script>
        (function () {
          var idInput = document.getElementById("customerId");
          var pinInput = document.getElementById("customerPin");
          var remember = document.getElementById("remember");
          var togglePin = document.getElementById("togglePin");
          var form = document.getElementById("customerLoginForm");

          try {
            var savedId = localStorage.getItem("rh_customer_id");
            if (savedId && idInput) idInput.value = savedId;
          } catch (e) {}

          if (togglePin && pinInput) {
            togglePin.addEventListener("click", function () {
              var isHidden = pinInput.type === "password";
              pinInput.type = isHidden ? "text" : "password";
              togglePin.textContent = isHidden ? "Hide" : "Show";
            });
          }

          if (form) {
            form.addEventListener("submit", function () {
              try {
                if (remember && remember.checked && idInput && idInput.value) {
                  localStorage.setItem("rh_customer_id", idInput.value.trim());
                } else {
                  localStorage.removeItem("rh_customer_id");
                }
              } catch (e) {}
            });
          }
        })();
      </script>
    </div>
  </div>
</div>

<%- include("_footer") %>
