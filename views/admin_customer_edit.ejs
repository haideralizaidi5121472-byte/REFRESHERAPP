<%- include("_header", { title: "Edit customer " + customer.id, appName, logoUrl, user }) %>

<%
  const safeNum = (v) => Number(v || 0) || 0;

  const wtypes = (waterTypes || []).map(w => ({
    id: w.id,
    name: String(w.name || ""),
    list_price: safeNum(w.list_price)
  }));

  const currentList = (() => {
    const row = wtypes.find(x => String(x.id) === String(customer.water_type_id));
    return row ? safeNum(row.list_price) : safeNum(customer.list_price);
  })();

  const currentUnit = safeNum(customer.unit_price);
  const currentDisc = Math.max(0, currentList - currentUnit);

  const openingBalanceVal = safeNum(customer.opening_balance);
  const openingBottleVal = safeNum(customer.opening_bottle);
  const bottlesBalanceVal = safeNum(customer.bottles_balance);

  const safeCurrency = (typeof currency !== "undefined" && currency) ? currency : "";
  const safeMsg = (typeof msg !== "undefined" && msg) ? String(msg) : "";
%>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card cardsoft p-3 p-md-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <div class="h5 mb-1">Edit customer</div>
          <div class="smallmuted">Update excel format fields, water type, price and access</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-dark btnround" href="/admin/customers/<%= customer.id %>">Back</a>
          <a class="btn btn-outline-dark btnround" href="/admin/customers">All customers</a>
        </div>
      </div>

      <% if (safeMsg) { %>
        <div class="alert alert-warning mt-3"><%= safeMsg %></div>
      <% } %>

      <form method="post" action="/admin/customers/<%= customer.id %>/update" class="row g-3 mt-1">

        <div class="col-12 col-md-4">
          <label class="form-label">CodeNo</label>
          <input class="form-control" value="<%= customer.id %>" disabled>
          <div class="form-text">Customer id cannot change</div>
        </div>

        <div class="col-12 col-md-8">
          <label class="form-label">Name</label>
          <input class="form-control" name="Name" value="<%= customer.name || '' %>" required>
        </div>

        <div class="col-12 col-md-4">
          <label class="form-label">MobileNo</label>
          <input class="form-control" name="MobileNo" value="<%= customer.phone || '' %>" inputmode="tel" placeholder="03xxxxxxxxx">
        </div>

        <div class="col-12 col-md-4">
          <label class="form-label">Area</label>
          <input class="form-control" name="Area" value="<%= customer.area || '' %>" placeholder="Example Gulshan DHA Model Town">
        </div>

        <div class="col-12 col-md-4">
          <label class="form-label">Customer PIN</label>
          <input class="form-control" name="password_plain" inputmode="numeric" placeholder="Leave blank to keep current">
          <div class="form-text">Blank means no change</div>
        </div>

        <div class="col-12">
          <label class="form-label">Address</label>
          <input class="form-control" name="Address" value="<%= customer.address || '' %>" placeholder="House street block etc">
        </div>

        <div class="col-12">
          <label class="form-label">Location</label>
          <input class="form-control" name="location" value="<%= customer.map_url || '' %>" placeholder="Google map link">
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label">Water type</label>
          <select class="form-select" name="water_type_id" id="wtSel" required>
            <% wtypes.forEach(w => { %>
              <option value="<%= w.id %>" <%= String(w.id) === String(customer.water_type_id) ? "selected" : "" %>><%= w.name %> (list <%= w.list_price %>)</option>
            <% }) %>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label">Customer price per bottle</label>
          <input class="form-control" name="unit_price" id="priceInp" type="number" min="0" value="<%= currentUnit %>" placeholder="">
          <div class="form-text">Leave empty or 0 to use list price</div>
        </div>

        <div class="col-12">
          <div class="p-3 rounded border bg-light">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <div class="small text-muted">Selected list price</div>
              <div class="fw-semibold" id="listShow"><%= currentList %> <%= safeCurrency %></div>
            </div>
            <div class="d-flex flex-wrap justify-content-between gap-2 mt-1">
              <div class="small text-muted">Customer unit price</div>
              <div class="fw-semibold" id="unitShow"><%= currentUnit %> <%= safeCurrency %></div>
            </div>
            <div class="d-flex flex-wrap justify-content-between gap-2 mt-1">
              <div class="small text-muted">Discount per bottle</div>
              <div class="fw-semibold text-success" id="discShow"><%= currentDisc %> <%= safeCurrency %></div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="row g-2">
            <div class="col-12 col-md-4">
              <label class="form-label">OpeningBalance</label>
              <input class="form-control" name="OpeningBalance" type="number" min="0" value="<%= openingBalanceVal %>">
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label">OpeningBottle</label>
              <input class="form-control" name="OpeningBottle" type="number" min="0" value="<%= openingBottleVal %>">
            </div>
            <div class="col-12 col-md-4">
              <label class="form-label">BottlesBalance</label>
              <input class="form-control" name="BottlesBalance" type="number" min="0" value="<%= bottlesBalanceVal %>">
            </div>
            <div class="col-12">
              <div class="form-text">These match your Excel sheet columns</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" value="1" name="is_active" id="isActive" <%= customer.is_active ? "checked" : "" %>>
            <label class="form-check-label" for="isActive">Active customer</label>
          </div>
        </div>

        <div class="col-12 d-grid d-md-flex gap-2">
          <button class="btn btn-primary btnround px-4" type="submit">Save changes</button>
          <a class="btn btn-outline-dark btnround px-4" href="/admin/customers/<%= customer.id %>">Cancel</a>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    try {
      var wtypes = <%- JSON.stringify(wtypes || []) %>;
      var wtSel = document.getElementById("wtSel");
      var priceInp = document.getElementById("priceInp");

      var listShow = document.getElementById("listShow");
      var unitShow = document.getElementById("unitShow");
      var discShow = document.getElementById("discShow");

      var currency = "<%= safeCurrency %>";

      function listPriceNow() {
        var id = wtSel && wtSel.value ? String(wtSel.value) : "";
        var row = (wtypes || []).find(function (x) { return String(x.id) === id; });
        return row ? Number(row.list_price || 0) : 0;
      }

      function unitPriceNow() {
        var raw = priceInp && priceInp.value != null ? String(priceInp.value).trim() : "";
        var v = raw === "" ? 0 : (Number(raw) || 0);
        if (!v || v <= 0) return listPriceNow();
        return v;
      }

      function render() {
        var lp = listPriceNow();
        var up = unitPriceNow();
        var disc = Math.max(0, (lp - up));

        if (listShow) listShow.textContent = lp + " " + currency;
        if (unitShow) unitShow.textContent = up + " " + currency;
        if (discShow) discShow.textContent = disc + " " + currency;

        if (priceInp) {
          var cur = priceInp.value != null ? String(priceInp.value).trim() : "";
          if (cur === "" || Number(cur) <= 0) {
            priceInp.placeholder = "List price is " + lp;
          }
        }
      }

      if (wtSel) wtSel.addEventListener("change", render);
      if (priceInp) priceInp.addEventListener("input", render);
      render();
    } catch (e) {}
  })();
</script>

<%- include("_footer") %>
